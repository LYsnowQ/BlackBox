/**
 * 个人库卡片 id（lg*）→ 详情 GameItem.id
 * Profile 列表仍用 lg*；详情页走复制自游戏库的商城数据。
 */
export function resolveProfileLibraryToGameId(libraryId: string): string {
  if (libraryId === 'lg1') {
    return 'black-myth-wukong';
  }
  if (libraryId === 'lg2') {
    return 'hades-2';
  }
  if (libraryId === 'lg3') {
    return 'palworld';
  }
  if (libraryId === 'lg4') {
    return 'elden-ring';
  }
  if (libraryId === 'lg5') {
    return 'cyberpunk-2077';
  }
  if (libraryId === 'lg6') {
    return 'hollow-knight-silksong';
  }
  if (libraryId === 'lg7') {
    return 'expedition-33';
  }
  if (libraryId === 'lg8') {
    return 'death-stranding-2';
  }
  if (libraryId === 'lg9') {
    return 'sekiro';
  }
  if (libraryId === 'lg10') {
    return 'starfield';
  }
  if (libraryId === 'lg11') {
    return 'baldurs-gate-3';
  }
  if (libraryId === 'lg12') {
    return 'monster-hunter-wilds';
  }
  if (libraryId === 'lg13') {
    return 'dmc-peak';
  }
  if (libraryId === 'lg14') {
    return 'permadeath-2';
  }
  if (libraryId === 'lg15') {
    return 'god-of-war-ragnarok';
  }
  if (libraryId === 'lg16') {
    return 'resident-evil-4';
  }
  // 已是详情 slug 或未知 id：原样返回，由 getGameById 处理
  return libraryId;
}

export function getGameById(id: string): GameItem | undefined {
  return gameList.find((item: GameItem) => item.id === id);
}

/** Profile 详情页不使用列表筛选；保留空实现避免其它误引用报错 */
export function getFilteredGames(
  _platformIndex: number,
  _categoryIndex: number,
  _payFilter?: string,
  _typeFilter?: string,
  _discountFilter?: string,
  _scoreFilter?: string
): GameItem[] {
  const result: GameItem[] = [];
  for (let i = 0; i < gameList.length; i++) {
    result.push(gameList[i]);
  }
  return result;
}

export class GameDataSource implements IDataSource {
  private listeners: DataChangeListener[] = [];
  private items: GameItem[] = [];

  constructor(items: GameItem[]) {
    this.items = items;
  }

  totalCount(): number {
    return this.items.length;
  }

  getData(index: number): GameItem {
    return this.items[index];
  }

  registerDataChangeListener(listener: DataChangeListener): void {
    if (this.listeners.indexOf(listener) < 0) {
      this.listeners.push(listener);
    }
  }

  unregisterDataChangeListener(listener: DataChangeListener): void {
    const pos = this.listeners.indexOf(listener);
    if (pos >= 0) {
      this.listeners.splice(pos, 1);
    }
  }

  notifyDataReload(): void {
    this.listeners.forEach((listener: DataChangeListener) => {
      listener.onDataReloaded();
    });
  }

  setItems(newItems: GameItem[]): void {
    this.items = newItems;
    this.notifyDataReload();
  }
}
